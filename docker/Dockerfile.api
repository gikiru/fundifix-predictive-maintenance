# FundiFix status API: FastAPI + the registered model + the explanation store.
# Used by docker-compose.yml (service "api") and by the Render web service (render.yaml).
FROM python:3.12-slim

# Runs as a non-root user
RUN useradd -m -u 1000 user
WORKDIR /app

COPY api/requirements.txt api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt

COPY src/models/__init__.py src/models/config.py src/models/data.py src/models/labels.py \
     src/models/explanation_store.py src/models/
COPY api/ api/
COPY models/fundifix_model.joblib models/model_meta.json models/

# The explanation store must be writable. Docker Compose mounts a volume here.
ENV FUNDIFIX_STORE=/app/store/explanation_store.duckdb PORT=7860
RUN mkdir -p /app/store && chown -R user:user /app
USER user

EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
  CMD python -c "import urllib.request,os; urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"PORT\"]}/health')"
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
