# FundiFix stakeholder dashboard (Streamlit), including the Monitoring tab.
FROM python:3.12-slim
WORKDIR /app
COPY app/requirements.txt app/requirements.txt
RUN pip install --no-cache-dir -r app/requirements.txt
COPY app/ app/
COPY models/fundifix_model.joblib models/
EXPOSE 8501
CMD ["streamlit", "run", "app/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
